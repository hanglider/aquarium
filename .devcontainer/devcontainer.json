// Окружение для GitHub Codespaces (и для VS Code Dev Containers локально).
{
  "name": "aquarium",
  "image": "mcr.microsoft.com/devcontainers/go:1.27-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Скачать зависимости один раз при создании, а не при первой сборке.
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
